# Copy this file to application-local.yaml only when local overrides are needed.
# application-local.yaml is ignored by Git. Start with SPRING_PROFILES_ACTIVE=local to load it.
# Production values should be supplied
# through the environment variables referenced by application.yaml.

spring:
  datasource:
    url: ${DB_URL}
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}

whatsapp:
  api-token: ${WHATSAPP_API_TOKEN}
  phone-number-id: ${WHATSAPP_PHONE_NUMBER_ID}
  verify-token: ${WHATSAPP_VERIFY_TOKEN}
  graph-api-version: ${WHATSAPP_GRAPH_API_VERSION:v19.0}

storage:
  receipts-directory: ${RECEIPTS_DIRECTORY}
  public-upload-directory: ${PUBLIC_UPLOAD_DIRECTORY}

langchain4j:
  ollama:
    chat-model:
      base-url: ${OLLAMA_BASE_URL:http://localhost:11434}
      model-name: ${OLLAMA_CHAT_MODEL:llama3.1}
    embedding-model:
      base-url: ${OLLAMA_BASE_URL:http://localhost:11434}
      model-name: ${OLLAMA_EMBEDDING_MODEL:nomic-embed-text}
rag:
  embedding-store:
    table: ${RAG_TABLE:menu_embeddings}
    dimension: ${RAG_DIMENSION:768}
  retrieval:
    max-results: ${RAG_MAX_RESULTS:15}
    min-score: ${RAG_MIN_SCORE:0.0}
  memory:
    max-messages: ${CHAT_MEMORY_MAX_MESSAGES:20}
